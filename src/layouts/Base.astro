---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource/open-sans/latin-300.css';
import '@fontsource/open-sans/latin-400.css';
import '@fontsource/open-sans/latin-500.css';
import '@fontsource/open-sans/latin-700.css';
import '@fontsource/inter/latin-300.css';
import '@fontsource/inter/latin-400.css';
import '../styles/global.css';

import { productSchema, businessSchema, breadcrumbSchema } from '../data/schema.js';

// `service` picks the page's Product schema in src/data/schema.js (review stars in Google results);
// `schema={false}` drops it (404, legal pages). `breadcrumbs` is [{ name, href }] after Home, the
// last one being this page; it draws the visible trail and the matching BreadcrumbList.
const { title, description, service = 'home', schema = true, noindex = false, breadcrumbs = null } = Astro.props;
// build.format 'file' makes Astro.url end in .html, but the server 301s /page.html to /page,
// so strip it: a canonical must be the address that actually returns 200.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/^\/index$/, '/');
const canonical = new URL(cleanPath, Astro.site);
const isHome = cleanPath === '/';
const crumbs = breadcrumbs ? [{ name: 'Home', href: '/' }, ...breadcrumbs] : null;
const graph = [
  ...(isHome ? businessSchema(Astro.site) : []),
  ...(schema ? [productSchema(service, canonical)] : []),
  ...(crumbs ? [breadcrumbSchema(crumbs, Astro.site)] : []),
].map(({ '@context': _, ...node }) => node);
const ogImage = new URL('/assets/img/og-default.jpg', Astro.site);
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FordFit Personal Training" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {graph.length > 0 && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      {crumbs && (
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol class="container">
            {crumbs.map((c, i) => (
              <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <Footer />
    <script>
      // Count numbers up from 0 when they scroll into view ([data-count], with optional prefix/suffix).
      const counters = document.querySelectorAll('[data-count]');
      if (counters.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const run = (el) => {
          const end = Number(el.dataset.count);
          const fmt = (n) => (el.dataset.prefix || '') + n.toLocaleString('en-GB') + (el.dataset.suffix || '');
          const t0 = performance.now();
          const step = (t) => {
            const k = Math.min(1, (t - t0) / 2000);
            el.textContent = fmt(Math.round(end * (1 - Math.pow(1 - k, 3))));
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        };
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { io.unobserve(e.target); run(e.target); } });
        }, { threshold: 0.6 });
        counters.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
