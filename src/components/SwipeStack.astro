---
// Tinder-style stack of photos: drag (or tap) the top card to send it away and show the next.
// Loops forever: three card elements are recycled and their photo swapped, and every photo is
// preloaded so a recycled card never flashes empty.
const { images } = Astro.props;
const first = images.slice(0, 3);
---
<div class="swipe" data-swipe data-images={JSON.stringify(images)} tabindex="0" role="group" aria-roledescription="carousel" aria-label="FordFit clients training together. Swipe, tap or use the arrow keys for the next photo.">
  {first.slice().reverse().map((src, i) => (
    <div class="swipe-card" data-depth={2 - i}>
      <img src={src} alt="FordFit clients training together" width="640" height="800" draggable="false" loading={i === 2 ? 'eager' : 'lazy'} />
    </div>
  ))}
</div>

<style>
  .swipe { width: 320px; height: 400px; margin: 0 auto; position: relative; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .swipe:focus-visible { outline: 3px solid currentColor; outline-offset: 8px; border-radius: 20px; }
  .swipe-card {
    position: absolute; inset: 0; border-radius: 18px; overflow: hidden; background: #111;
    box-shadow: 0 12px 40px rgba(0, 0, 0, .3); cursor: grab; will-change: transform;
    transition: transform .3s ease, opacity .3s ease;
  }
  .swipe-card:active { cursor: grabbing; }
  .swipe-card[data-depth='0'] { transform: none; z-index: 3; }
  .swipe-card[data-depth='1'] { transform: translateY(10px) scale(.98); z-index: 2; }
  .swipe-card[data-depth='2'] { transform: translateY(20px) scale(.96); z-index: 1; }
  .swipe-card img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  @media (max-width: 480px) { .swipe { width: 60vw; height: calc(60vw * 1.25); } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-swipe]').forEach((stack) => {
    const images: string[] = JSON.parse(stack.dataset.images || '[]');
    const cards = [...stack.querySelectorAll<HTMLElement>('.swipe-card')];
    if (cards.length < 2 || images.length < 2) return;

    // Preload every photo once the stack is near the screen.
    const preload = () => images.forEach((src) => { const i = new Image(); i.src = src; });
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((e) => { if (e[0].isIntersecting) { preload(); io.disconnect(); } }, { rootMargin: '400px' });
      io.observe(stack);
    } else preload();

    let next = cards.length; // index of the photo the next recycled card shows
    let busy = false;
    const top = () => cards.find((c) => c.dataset.depth === '0')!;

    // Send the top card away, then put it at the back with the next photo.
    const advance = (dir: number, dy = 0) => {
      if (busy) return;
      busy = true;
      const card = top();
      const dist = stack.offsetWidth * 1.3;
      card.style.transition = 'transform .28s ease-out, opacity .28s ease-out';
      card.style.transform = `translate(${dir * dist}px, ${dy}px) rotate(${dir * 18}deg)`;
      card.style.opacity = '0';
      cards.forEach((c) => { if (c !== card) c.dataset.depth = String(Number(c.dataset.depth) - 1); });
      setTimeout(() => {
        card.style.transition = 'none';
        card.dataset.depth = String(cards.length - 1);
        card.querySelector('img')!.src = images[next++ % images.length];
        card.style.transform = '';
        card.style.opacity = '';
        void card.offsetWidth; // apply the reset before transitions come back
        card.style.transition = '';
        busy = false;
      }, 290);
    };

    let sx = 0, sy = 0, dx = 0, dy = 0, dragging = false, card: HTMLElement | null = null;
    stack.addEventListener('pointerdown', (e) => {
      if (busy || e.button > 0) return;
      card = top();
      if (!card.contains(e.target as Node)) return;
      dragging = true; sx = e.clientX; sy = e.clientY; dx = dy = 0;
      card.style.transition = 'none';
      card.setPointerCapture(e.pointerId);
    });
    stack.addEventListener('pointermove', (e) => {
      if (!dragging || !card) return;
      dx = e.clientX - sx; dy = e.clientY - sy;
      card.style.transform = `translate(${dx}px, ${dy * 0.3}px) rotate(${dx * 0.05}deg)`;
    });
    const end = () => {
      if (!dragging || !card) return;
      dragging = false;
      card.style.transition = '';
      if (Math.abs(dx) > 70) advance(dx > 0 ? 1 : -1, dy * 0.3);
      else if (Math.abs(dx) < 6 && Math.abs(dy) < 6) advance(1); // a tap moves on too
      else card.style.transform = '';
    };
    stack.addEventListener('pointerup', end);
    // The browser took over (page scroll): put the card back, don't treat it as a tap.
    stack.addEventListener('pointercancel', () => {
      if (!dragging || !card) return;
      dragging = false;
      card.style.transition = '';
      card.style.transform = '';
    });
    stack.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); advance(e.key === 'ArrowRight' ? 1 : -1); }
    });
  });
</script>
